st_name":"Bernt","last_name":"Lindtjørn1","affiliation":"1 School of Public Health, Hawassa University, Hawassa, Ethiopia ","note":"","guid":"","username":"","name":"Bernt Lindtjørn1","affiliation_url":null,"link":null,"is_private_profile":false,"is_verified_user":false,"user_image_file":{"guid":"00000000000000000000000000000001","file_name":"avatar.png","url":"https://www.protocols.io/img/avatars/001.png","mime":"image/png","size":0,"width":100,"height":100,"avg_color":"","scan_status":0,"created_at":0}},{"first_name":"2","last_name":"","affiliation":"2 Centre for International Health, University of Bergen, Bergen, Norway","note":"","guid":"","username":"","name":"2 ","affiliation_url":null,"link":null,"is_private_profile":false,"is_verified_user":false,"user_image_file":{"guid":"00000000000000000000000000000001","file_name":"avatar.png","url":"https://www.protocols.io/img/avatars/001.png","mime":"image/png","size":0,"width":100,"height":100,"avg_color":"","scan_status":0,"created_at":0}}],"before_start":null,"book_chapter":null,"can_accept_authorship":false,"can_be_copied":true,"can_claim_authorship":false,"can_manage_keywords":true,"can_remove_fork":false,"can_sign":false,"child_steps":{},"cited_protocols":[],"collection_items":[],"created_on":1573564779,"creator":{"name":"Solomon Hailemariam","first_name":"","last_name":"","affiliation":"","affiliation_url":null,"username":"solomon-hailemariam","link":null,"user_image_file":{"guid":"00000000000000000000000000000001","file_name":"avatar.png","url":"https://www.protocols.io/img/avatars/001.png","mime":"image/png","size":0,"width":100,"height":100,"avg_color":"","scan_status":0,"created_at":0},"badges":[{"id":2,"name":"Author","image":{"source":"https://files.protocols.io/webapp/images/q2ckeg/badges/bronze.svg","placeholder":"https://files.protocols.io/webapp/images/q2ckeg/badges/bronze.svg"}}],"affiliations":[]},"cross_cloud_origin":null,"description":"{\"blocks\":[{\"key\":\"899vv\",\"text\":\"Abstract \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"style\":\"bold\",\"offset\":0,\"length\":9}],\"entityRanges\":[],\"data\":[]},{\"key\":\"70piv\",\"text\":\"Background: Hypoxemia is common in children with pneumonia. The World Health Organization and United Nations Children’s Fund developed the Integrated Management of Childhood Illness strategy for diagnosing pneumonia. But the strategy has limitations to accurately detect hypoxemia in children with severe pneumonia. This study will assess whether pulse oximetry improves health workers’ performance in diagnosing severe childhood pneumonia and whether the pulse oximeter is a cost-effective tool to improve diagnoses of severe pneumonia at primary health care units in South Ethiopia.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"style\":\"bold\",\"offset\":0,\"length\":10}],\"entityRanges\":[],\"data\":[]},{\"key\":\"2eckp\",\"text\":\"Methods: A cluster-randomized controlled trial will be conducted at 24 health centres in southern Ethiopia from September 2018 to February 2019. The trial has two arms: the first arm will examine the combined use of the Integrated Management of Childhood Illness (IMCI) strategy with pulse oximetry, and the second arm will examine the use of the IMCI strategy alone. The study population will include children between 2 months and 59 months of age who present with cough or difficult breathing. The primary outcome of this trial is severe childhood pneumonia, as diagnosed via the IMCI guideline and pulse oximetry. Secondary outcomes will be referred cases of severe pneumonia, and treatment failure on day 14 after enrolment. A cost effectiveness study will be conducted simultaneously.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"style\":\"bold\",\"offset\":0,\"length\":7}],\"entityRanges\":[],\"data\":[]},{\"key\":\"41g3q\",\"text\":\"Discussion: This study will determine if using a pulse oximeter at health facilities in rural Southern Ethiopia improves diagnostic accuracy for paediatric severe pneumonia. Our secondary aim will be to evaluate if the benefit of pulse oximetry justifies its cost. \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"style\":\"bold\",\"offset\":0,\"length\":10}],\"entityRanges\":[],\"data\":[]},{\"key\":\"2cni\",\"text\":\"Trial registration: PACTR201807164196402(14/06/2018). URL:https://pactr.samrc.ac.za/TrialDisplay.aspx?TrialID=3466. \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"style\":\"bold\",\"offset\":0,\"length\":20}],\"entityRanges\":[{\"key\":0,\"offset\":58,\"length\":56}],\"data\":[]}],\"entityMap\":{\"0\":{\"type\":\"link\",\"mutability\":\"\",\"data\":{\"guid\":\"6568961C11D84C258F39AFBEBC02DC72\",\"url\":\"https://pactr.samrc.ac.za/TrialDisplay.aspx?TrialID=3466\"}}}}","disclaimer":null,"document":null,"documents":[{"id":50880,"guid":"","type_id":0,"filename":"","key":"","color":"","height":0,"width":0,"is_document":null,"original_file_id":null,"thumb_url":"/img/extensions/docx.png","size":113815,"is_private":0,"is_new":0,"ofn":"Protocol.docx","url":"https://content.protocols.io/public/d79d8face370838859f4feeb423c58c124b4960a5372745bff4e7282741e16ab/btyababuf.docx","bucket_name":null,"s3_webp_url":"","file_id":50880}],"doi":"dx.doi.org/10.17504/protocols.io.88mhzu6","doi_status":2,"ethics_statement":null,"fork_id":null,"fork_info":null,"fork_info_status":"not_fork","forks":[],"funders":[],"groups":[],"guid":"52E7C390054E11EA94E3A72C2BC0E3C4","guidelines":null,"has_references":false,"has_step_reagents":false,"has_versions":false,"id":29677,"image":{"placeholder":null,"source":"https://www.protocols.io/img/default_protocol.png","webp_placeholder":null,"webp_source":null},"image_attribution":null,"in_trash":false,"is_bookmarked":false,"is_contact_suspended":false,"is_content_confidential":false,"is_content_warning":false,"is_doi_reserved":false,"is_in_pending_publishing":false,"is_in_transfer":false,"is_owner":true,"is_research":true,"is_retracted"