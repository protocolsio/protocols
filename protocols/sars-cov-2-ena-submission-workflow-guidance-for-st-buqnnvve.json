inistration","url":"","job_title":null,"is_default":true}]},"cross_cloud_origin":null,"description":"{\"blocks\":[{\"key\":\"fh50b\",\"text\":\"PURPOSE:\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"style\":\"bold\",\"offset\":0,\"length\":8}],\"entityRanges\":[],\"data\":{}},{\"key\":\"3vbvc\",\"text\":\"This workflow provides an overview on the metadata specification recommended for SARS-CoV-2 sequence data and a series of protocols outlining the steps for ENA submission.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"style\":\"bold\",\"offset\":0,\"length\":171}],\"entityRanges\":[],\"data\":{}},{\"key\":\"feu0v\",\"text\":\"\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"3msm4\",\"text\":\"PHA4GE Contextual Metadata SOP\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"style\":\"bold\",\"offset\":0,\"length\":30}],\"entityRanges\":[{\"key\":0,\"offset\":0,\"length\":30}],\"data\":{}},{\"key\":\"ecmfn\",\"text\":\"This protocol provides step-by-step instructions for populating the template, and also addresses a number of ethical, privacy and practical considerations that should be discussed with your data steward prior to any type of data sharing.\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"ffm8n\",\"text\":\"The appendices provide additional instructions and examples of how to curate sample type descriptions, and how to identify additional standardized terms should you need them.\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"tnjf\",\"text\":\"\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"b8bu8\",\"text\":\"SOP for populating EBI submission templates (ENA)\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"style\":\"bold\",\"offset\":0,\"length\":49}],\"entityRanges\":[{\"key\":1,\"offset\":0,\"length\":49}],\"data\":{}},{\"key\":\"am8u9\",\"text\":\"Guidance for populating the ENA metadata template using PHA4GE fields and terms.\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"4vuef\",\"text\":\"\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"fnimi\",\"text\":\"SARS-CoV-2 EBI submission protocol: ENA, BioSample, and BioProject\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"style\":\"bold\",\"offset\":0,\"length\":66}],\"entityRanges\":[{\"key\":2,\"offset\":0,\"length\":66}],\"data\":{}},{\"key\":\"bm1pi\",\"text\":\"Step-by-step instructions for establishing a new EBI (Webin) submission account and for creating and linking a new BioProject to an existing umbrella effort.\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"2r0hn\",\"text\":\"SARS-CoV-2 raw data submission to ENA (European Nucleotide Archive) and metadata to BioSample.\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"2lfnt\",\"text\":\"\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{\"0\":{\"type\":\"link\",\"mutability\":\"\",\"data\":{\"guid\":\"B361A85FA75A11EBA91D0A58A9FEAC02\",\"url\":\"https://dx.doi.org/10.17504/protocols.io.btpznmp6\"}},\"1\":{\"type\":\"link\",\"mutability\":\"\",\"data\":{\"guid\":\"B361A8BCA75A11EBA91D0A58A9FEAC02\",\"url\":\"https://www.protocols.io/view/sop-for-populating-ebi-submission-templates-ena-bh5dj826\"}},\"2\":{\"type\":\"link\",\"mutability\":\"\",\"data\":{\"guid\":\"B361A900A75A11EBA91D0A58A9FEAC02\",\"url\":\"https://www.protocols.io/view/sars-cov-2-ebi-submission-protocol-ena-biosample-a-bhwdj7a6\"}}}}","disclaimer":"{\"blocks\":[{\"key\":\"9lcu4\",\"text\":\"Please note that th