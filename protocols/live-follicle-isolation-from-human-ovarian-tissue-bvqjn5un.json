{"access":{"can_preview":true,"can_view":true,"can_edit":false,"can_remove":false,"can_add":true,"can_publish":false,"can_get_doi":false,"can_share":true,"can_share_organization":false,"can_move":true,"can_move_outside":true,"can_transfer":true,"can_download":true,"limited_run":false,"limited_private_links":false,"limited_blind_links":false,"is_locked":false},"acknowledgements":null,"authors":[{"first_name":"Andrea","last_name":"Jones","affiliation":"University of Michigan - Ann Arbor","note":"","guid":"038780E3F8CC11ED9D4302C0B41BC903","username":"andrea---jones","name":"Andrea Jones","affiliation_url":null,"link":null,"is_private_profile":false,"is_verified_user":true,"user_image_file":{"guid":"00000000000000000000000000000001","file_name":"avatar.png","url":"https://www.protocols.io/img/avatars/001.png","mime":"image/png","size":0,"width":100,"height":100,"avg_color":"","scan_status":0,"created_at":0}},{"first_name":"Jordan","last_name":"H Machlin","affiliation":"University of Michigan - Ann Arbor","note":"","guid":"044A7598F8CC11ED9D4302C0B41BC903","username":"jordan-machlin","name":"Jordan H Machlin","affiliation_url":null,"link":"","is_private_profile":false,"is_verified_user":true,"user_image_file":{"guid":"00000000000000000000000000000001","file_name":"avatar.png","url":"https://www.protocols.io/img/avatars/001.png","mime":"image/png","size":0,"width":100,"height":100,"avg_color":"","scan_status":0,"created_at":0}},{"first_name":"Ariella","last_name":"Shikanov","affiliation":"University of Michigan - Ann Arbor","note":"","guid":"03877ECFF8CC11ED9D4302C0B41BC903","username":"ariella-shikanov","name":"Ariella Shikanov","affiliation_url":null,"link":null,"is_private_profile":false,"is_verified_user":true,"user_image_file":{"guid":"CCE61D195B2A11EFA2EF0A58A9FEAC02","file_name":"brhf8ubn.jpg","url":"https://files.protocols.io/external/brhf8ubn-CCE61D195B2A11EFA2EF0A58A9FEAC02.jpg","mime":"image/jpeg","size":24237,"width":0,"height":0,"avg_color":"","scan_status":0,"created_at":1723742485}}],"before_start":"","book_chapter":null,"can_accept_authorship":false,"can_be_copied":true,"can_claim_authorship":false,"can_manage_keywords":true,"can_remove_fork":false,"can_sign":false,"child_steps":{},"cited_protocols":[],"collection_items":[],"created_on":1623350434,"creator":{"name":"Andrea Jones","first_name":"","last_name":"","affiliation":"Duke University","affiliation_url":null,"username":"andrea---jones","link":null,"user_image_file":{"guid":"00000000000000000000000000000001","file_name":"avatar.png","url":"https://www.protocols.io/img/avatars/001.png","mime":"image/png","size":0,"width":100,"height":100,"avg_color":"","scan_status":0,"created_at":0},"badges":[{"id":2,"name":"Author","image":{"source":"https://files.protocols.io/webapp/images/q2ckeg/badges/bronze.svg","placeholder":"https://files.protocols.io/webapp/images/q2ckeg/badges/bronze.svg"}}],"affiliations":[{"affiliation":"Duke University","url":null,"job_title":null,"is_default":true}]},"cross_cloud_origin":null,"description":"{\"blocks\":[{\"key\":\"dlevb\",\"text\":\"This protocol outlines steps to obtain live primordial/primary follicles from fresh or cryopreserved human ovarian cortex. Here, we do not outline steps for removing the ovarian cortex from the organ and slicing 1 mm thick sections, nor do we outline cryopreservation and tissue thawing methods. Tissue is digested enzymatically using Collagenase IA and DNase I then follicles are isolated from the digested tissue first using cell strainers and then by individual collection from the suspension. Note that RBC lysis step may not be necessary if organ was perfused prior to tissue collection.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}","disclaimer":"","document":"","documents":null,"doi":"dx.doi.org/10.17504/protocols.io.4r3l24px4g1y/v1","doi_status":2,"ethics_statement":null,"fork_id":null,"fork_info":null,"fork_info_status":"not_fork","forks":[],"funders":[],"groups":[{"id":1321,"uri":"femalereprotract","title":"female_repro_tract","is_public":true,"image":{"source":"https://s3.amazonaws.com/protocols-files/public/c4dc59927a52536efd42983d6e956d03467a02b3209f8ab473c842d40e1c2386/bqqq8ubn.png","placeholder":"https://s3.amazonaws.com/protocols-files/public/c4dc59927a52536efd42983d6e956d03467a02b3209f8ab473c842d40e1c2386/bqqq8ubn.png"},"tech_support":{"email":null,"phone":null,"use_email":false,"hide_contact":false,"url":null}},{"id":26853,"uri":"shikanov-lab","title":"Shikanov Lab","is_public":true,"image":{"source":"https://s3.amazonaws.com/protocols-files/files/271DC85E2A9411EC96350A58A9FEAC02-placeholder.png","placeholder":"https://s3.amazonaws.com/protocols-files/files/271DC85E2A9411EC96350A58A9FEAC02-placeholder.png"},"tech_support":{"email":null,"phone":null,"use_email":false,"hide_contact":false,"url":null}}],"guid":"ABC9E8038A6C45F7A1D99EFD40CD76FD","guidelines":"","has_references":false,"has_step_reagents":false,"has_versions":false,"id":50667,"image":{"placeholder":null,"source":"https://www.protocols.io/img/default_protocol.png","webp_placeholder":null,"webp_source":null},"image_attribution":"","in_trash":false,"is_bookmarked":false,"is_contact_suspended":false,"is_content_confidential":false,"is_content_warning":false,"is_doi_reserved":false,"is_in_pending_publishing":false,"is_in_transfer":false,"is_owner":true,"is_research":false,"is_retracted":false,"is_shared_directly":false,"is_subprotocol":null,"is_unlisted":false,"item_id":800924,"keywords":"live follicle isolation from human ovarian tissue, live follicle isolation, human ovarian tissue, primary follicle, ovarian cortex from the organ, follicle, human ovarian cortex, ovarian cortex, tissue collection, digested tissue, tissue, using collagenase ia, using cell strainer, cryopreservation, cell strainer, rbc lysis step","last_modified":1779107466,"link":"","location":null,"manuscript_citation":"","materials":[],"materials_text":"{\"blocks\":[{\"key\":\"bbs7t\",\"text\":\"Supplies for tissue preparation: glass petri dish, disposable #10 surgical blade, DPBS -/- (optional: tissue chopping device for mincing tissue).\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"aedrc\",\"text\":\"Supplies for digestion: Small spatulas, 70 and 30 μm strainers, 30 and 60 mm petri dishes, conical tubes (1.5, 5, and 15 mL), sterile DPBS +/+ and -/-, BSA (Fisher BP9706), FBS (Fisher 10-082-147), Collagenase IA (Sigma C2674), DNase I (Sigma D4138), wide-bore pipette tips, incubating shaker.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}","mention":null,"mentions":[],"ownership_history":null,"parent_collections":[],"parent_protocols":[],"peer_reviewed":false,"protocol_image_file":{"avg_color":"","created_at":0,"file_name":"avatar.png","guid":"00000000000000000000000000000001","height":400,"mime":"image/png","scan_status":0,"size":0,"url":"https://www.protocols.io/img/default_protocol.png","width":400},"protocol_references":"","public":true,"public_fork_note":"","published_on":1623433894,"references":[],"related_equipments":[],"related_materials":[],"reserved_doi":"","retraction_reason":null,"samples":{},"shared_access_id":16,"should_acknowledge":false,"show_comparison":false,"sign_info":null,"space_access":{"can_preview":false,"can_view":false,"can_edit":false,"can_remove":false,"can_add":false,"can_publish":true,"can_get_doi":true,"can_share":false,"can_share_organization":false,"can_move":false,"can_move_outside":false,"can_transfer":false,"can_download":false,"limited_run":false,"limited_private_links":false,"limited_blind_links":false,"is_locked":false},"space_id":1388,"state_version_id":0,"stats":{"is_voted":false,"number_of_views":305,"number_of_steps":13,"number_of_bookmarks":0,"number_of_comments":0,"number_of_bookmarked_comments":0,"number_of_steps_comments":0,"number_of_protocol_comments":0,"number_of_exports":5,"number_of_runs":0,"number_of_votes":0,"number_of_reagents":0,"number_of_equipments":0,"number_of_collections":0,"number_of_forks":{"private":0,"public":0},"number_of_accessible_forks":0},"status":{"id":1,"info":"This protocol has been validated using Live/Dead staining and immunofluorescent staining."},"steps":[{"id":1194489,"guid":"CE74CC8B57C641728E26DFECDCE9110D","previous_id":null,"previous_guid":null,"section":"\u003cp\u003ePreparations\u003c/p\u003e","section_color":"#A492FF","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"17hce\",\"text\":\"Prepare enzymes: Dilute DNase I stock (2% w/v) to 2 mg/mL by combining 10 μL stock with 90 μL DPBS +/+. Mix well and store on ice for the duration of cell isolation. Collagenase stock at 100 mg/mL should be stored on ice for the duration of cell isolation.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":[]}],\"entityMap\":{}}","data":null,"protocol_id":50667,"case_id":0,"critical_ids":"","duration":0,"original_id":1194386,"number":"1","cases":[],"critical":null},{"id":1194490,"guid":"0AB8CD1DF1014A668A542FE3ABC93B66","previous_id":1194489,"previous_guid":"CE74CC8B57C641728E26DFECDCE9110D","section":"\u003cp\u003ePreparations\u003c/p\u003e","section_color":"#A492FF","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"2738d\",\"text\":\"Pre-weigh an empty 30 mm dish. This will be used to measure the mass of tissue prior to digestion.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":[]}],\"entityMap\":{}}","data":null,"protocol_id":50667,"case_id":0,"critical_ids":"","duration":0,"original_id":1194391,"number":"2","cases":[],"critical":null},{"id":1194491,"guid":"CF1EFF08B337455499CEAD8B10FA3333","previous_id":1194490,"previous_guid":"0AB8CD1DF1014A668A542FE3ABC93B66","section":"\u003cp\u003ePreparations\u003c/p\u003e","section_color":"#A492FF","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"63ape\",\"text\":\"Prepare solutions for digest.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}","data":null,"protocol_id":50667,"case_id":0,"critical_ids":"","duration":0,"original_id":1194401,"number":"3","cases":[],"critical":null},{"id":1194492,"guid":"C93EBD12F5034D37BD70ADDD460C6FE3","previous_id":1194491,"previous_guid":"CF1EFF08B337455499CEAD8B10FA3333","section":"\u003cp\u003ePreparations\u003c/p\u003e","section_color":"#A492FF","section_duration":0,"is_substep":true,"step":"{\"blocks\":[{\"key\":\"dmca0\",\"text\":\"Prepare Inactivation Solution (15 mL DPBS -/- with 10% FBS). Keep solution on ice for duration of experiment.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":[]}],\"entityMap\":{}}","data":null,"protocol_id":50667,"case_id":0,"critical_ids":"","duration":0,"original_id":1194408,"number":"3.1","cases":[],"critical":null},{"id":1194493,"guid":"0199DB85574045EB80851CACB5EF415E","previous_id":1194492,"previous_guid":"C93EBD12F5034D37BD70ADDD460C6FE3","section":"\u003cp\u003ePreparations\u003c/p\u003e","section_color":"#A492FF","section_duration":0,"is_substep":true,"step":"{\"blocks\":[{\"key\":\"7masl\",\"text\":\"Aliquot 15 mL DPBS +/+ for digest solution. It is crucial that DPBS +/+ be used, as the magnesium and calcium aid in enzymatic digestion. Keep in a bead bath for duration of experiment to keep solution warm.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":[]}],\"entityMap\":{}}","data":null,"protocol_id":50667,"case_id":0,"critical_ids":"","duration":0,"original_id":1194409,"number":"3.2","cases":[],"critical":null},{"id":1194494,"guid":"C21322C9C19E46A4B83BC7BF9DC19B11","previous_id":1194493,"previous_guid":"0199DB85574045EB80851CACB5EF415E","section":"\u003cp\u003ePreparations\u003c/p\u003e","section_color":"#A492FF","section_duration":0,"is_substep":true,"step":"{\"blocks\":[{\"key\":\"dpj62\",\"text\":\"Prepare red blood cell (RBC) lysis buffer. Dilute 1 mL RBC lysis buffer stock into 9 mL sterile DI water. Keep solution warm in bead bath for duration of experiment. \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":[]}],\"entityMap\":{}}","data":null,"protocol_id":50667,"case_id":0,"critical_ids":"","duration":0,"original_id":1194457,"number":"3.3","cases":[],"critical":null},{"id":1194496,"guid":"FE4640ED1AD2492FAF461496A8D3D376","previous_id":1194494,"previous_guid":"C21322C9C19E46A4B83BC7BF9DC19B11","section":"\u003cp\u003eTissue Cutting and Digest\u003c/p\u003e","section_color":"#94EBFF","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"5uild\",\"text\":\"Starting with 1 mm thick pieces of ovarian cortex or medulla, cut all tissue into ~1mm3 pieces either a) mechanically using a #10 blade in a glass petri dish or b) using a tissue chopper.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"style\":\"sup\",\"offset\":86,\"length\":1}],\"entityRanges\":[],\"data\":[]}],\"entityMap\":{}}","data":null,"protocol_id":50667,"case_id":0,"critical_ids":"","duration":0,"original_id":1194319,"number":"4","cases":[],"critical":null},{"id":1194497,"guid":"B76811BEA3C247919ABF9543E0D88AA9","previous_id":1194496,"previous_guid":"FE4640ED1AD2492FAF461496A8D3D376","section":"\u003cp\u003eTissue Cutting and Digest\u003c/p\u003e","section_color":"#94EBFF","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"fu779\",\"text\":\"After cutting, move tissue to a cell strainer (any pore size) and rinse tissue with DPBS -/- twice to wash off any media or previous solutions.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":[]}],\"entityMap\":{}}","data":null,"protocol_id":50667,"case_id":0,"critical_ids":"","duration":0,"original_id":1194382,"number":"5","cases":[],"critical":null},{"id":1194498,"guid":"B1879909C038425EB328D759107852BF","previous_id":1194497,"previous_guid":"B76811BEA3C247919ABF9543E0D88AA9","section":"\u003cp\u003eTissue Cutting and Digest\u003c/p\u003e","section_color":"#94EBFF","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"1ooev\",\"text\":\"Using a spatula, transfer the cut tissue to the pre-weighed 30 mm petri dish. Weigh tissue in pre-weighed dish to obtain tissue mass. Add 2 mL DPBS +/+ to the dish, then add 20 μL Collagenase IA (stock = 100 mg/mL) and 20 μL diluted DNase I for a solution of 1 mg/mL Collagenase IA and 0.02 mg/mL DNase I in DPBS +/+.\",\"type\":\"align-left\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}","data":null,"protocol_id":50667,"case_id":0,"critical_ids":"","duration":0,"original_id":1194383,"number":"6","cases":[],"critical":null},{"id":1194499,"guid":"657D04575BCF485DA7F6738F061C236C","previous_id":1194498,"previous_guid":"B1879909C038425EB328D759107852BF","section":"\u003cp\u003eTissue Cutting and Digest\u003c/p\u003e","section_color":"#94EBFF","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"3e7h\",\"text\":\"Place 30 mm dish with tissue in a secondary container and tape down if necessary. Tape dish to shaker and digest for 2 hours at 150 rpm and 37ºC. Tissue pieces should be freely moving in the digest solution to obtain proper enzymatic digestion and leverage mechanical disruption for cell isolation. \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}","data":null,"protocol_id":50667,"case_id":0,"critical_ids":"","duration":0,"original_id":1194393,"number":"7","cases":[],"critical":null},{"id":1194500,"guid":"D92AE734D7D642389A74C2193EB318C1","previous_id":1194499,"previous_guid":"657D04575BCF485DA7F6738F061C236C","section":"\u003cp\u003eTissue Cutting and Digest\u003c/p\u003e","section_color":"#94EBFF","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"drg18\",\"text\":\"After 2 hours, strain tissue and supernatant through a 70 μm strainer over a 60 mm dish. A 30 μm strainer can also be used to \\\"catch\\\" follicles with diameters ranging from 30-70 μm in the top of the 30 μm cell strainer - backwash the 30 μm strainer with DPBS -/- to collect these follicles. To collect follicles with diameters \\u003e 70 μm, you may consider implementing a larger  cell strainer (150 μm) and backwashing the 70 μm cell strainer, however this will also yield 70-150 μm tissue fragments remaining from the digest.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}","data":null,"protocol_id":50667,"case_id":0,"critical_ids":"","duration":0,"original_id":1194399,"number":"8","cases":[],"critical":null},{"id":1194501,"guid":"371CB6E99A454629ACAF0A3735BFDBFF","previous_id":1194500,"previous_guid":"D92AE734D7D642389A74C2193EB318C1","section":"\u003cp\u003eTissue Cutting and Digest\u003c/p\u003e","section_color":"#94EBFF","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"6u1u\",\"text\":\"Add 2 mL ice-cold Inactivation Solution to the 60 mm dish of backwashed follicles to halt enzyme activity. Keep follicles in solution on ice and proceed with mechanical follicle collection, sorting, and/or staining.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}","data":null,"protocol_id":50667,"case_id":0,"critical_ids":"","duration":0,"original_id":1194400,"number":"9","cases":[],"critical":null},{"id":1195000,"guid":"3FF55D00CADD11EB995E754982EEDA6B","previous_id":1194501,"previous_guid":"371CB6E99A454629ACAF0A3735BFDBFF","section":"\u003cp\u003eTissue Cutting and Digest\u003c/p\u003e","section_color":"#94EBFF","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"c0989\",\"text\":\"Optional RBC Lysis step: If tissue is bloody prior to digest, consider spinning down cell suspension for 5 minutes at 100g at the end of the digest and resuspending in 1X RBC lysis buffer, then incubating at room temperature for 2 minutes to lyse red blood cells. \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}","data":null,"protocol_id":50667,"case_id":0,"critical_ids":"","duration":0,"original_id":0,"number":"10","cases":[],"critical":null}],"table_of_contents":[{"title":"\u003cp\u003ePreparations\u003c/p\u003e","color":"#A492FF","first_step_guid":"CE74CC8B57C641728E26DFECDCE9110D"},{"title":"\u003cp\u003eTissue Cutting and Digest\u003c/p\u003e","color":"#94EBFF","first_step_guid":"FE4640ED1AD2492FAF461496A8D3D376"}],"template_id":4,"title":"Live Follicle Isolation from Human Ovarian Tissue","title_html":"Live Follicle Isolation from Human Ovarian Tissue","translations":[{"lang":"de","title":"German","created_on":1775226700},{"lang":"es","title":"Spanish","created_on":1775226700},{"lang":"fr","title":"French","created_on":1775226700},{"lang":"ja","title":"Japanese","created_on":1775226700},{"lang":"zh","title":"Chinese - Simp/Trad","created_on":1775226700}],"troubleshooting_items":[],"type_id":1,"units":[{"id":1,"type_id":3,"name":"µL","can_manage":0,"read_only":0,"deleted":false},{"id":2,"type_id":3,"name":"mL","can_manage":0,"read_only":0,"deleted":false},{"id":3,"type_id":3,"name":"L","can_manage":0,"read_only":0,"deleted":false},{"id":4,"type_id":3,"name":"µg","can_manage":0,"read_only":0,"deleted":false},{"id":5,"type_id":3,"name":"mg","can_manage":0,"read_only":0,"deleted":false},{"id":6,"type_id":3,"name":"g","can_manage":0,"read_only":0,"deleted":false},{"id":7,"type_id":3,"name":"kg","can_manage":0,"read_only":0,"deleted":false},{"id":8,"type_id":3,"name":"ng","can_manage":0,"read_only":0,"deleted":false},{"id":9,"type_id":3,"name":"Hz","can_manage":0,"read_only":0,"deleted":false},{"id":10,"type_id":24,"name":"°C","can_manage":0,"read_only":0,"deleted":false},{"id":11,"type_id