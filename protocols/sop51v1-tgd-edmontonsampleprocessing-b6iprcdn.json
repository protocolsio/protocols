; color: var(--theme-primary) !important;\"\u003ehttps://protocols.io/view/sop51v1-tgd-edmontonsampleprocessing-b6iprcdn\u003c/a\u003e","cited_protocols":[],"collection_items":[],"created_on":1647878051,"creator":{"name":"Varsha Rajesh","first_name":"","last_name":"","affiliation":"Stanford University","affiliation_url":null,"username":"varsha-rajesh","link":null,"user_image_file":{"guid":"00000000000000000000000000000001","file_name":"avatar.png","url":"https://www.protocols.io/img/avatars/001.png","mime":"image/png","size":0,"width":100,"height":100,"avg_color":"","scan_status":0,"created_at":0},"badges":[{"id":3,"name":"Power author!","image":{"source":"https://files.protocols.io/webapp/images/q2ckeg/badges/silver.svg","placeholder":"https://files.protocols.io/webapp/images/q2ckeg/badges/silver.svg"}}],"affiliations":[{"affiliation":"Stanford University","url":null,"job_title":null,"is_default":true}]},"cross_cloud_origin":null,"description":"{\"blocks\":[{\"key\":\"1g32k\",\"text\":\"This protocol covers the sample processing steps for samples received from the Alberta Diabetes Institute IsletCore at the Translational Genomics of Diabetes Lab at Stanford University.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}","disclaimer":"","document":"","documents":null,"doi":null,"doi_status":0,"ethics_statement":"","fork_id":null,"fork_info":null,"fork_info_status":"not_fork","forks":[],"funders":[],"groups":[],"guid":"24E53180A92F11ECBED56572DFA95D8E","guidelines":"","has_references":false,"has_step_reagents":false,"has_versions":false,"id":59695,"image":{"placeholder":null,"source":"https://www.protocols.io/img/default_protocol.png","webp_placeholder":null,"webp_source":null},"image_attribution":"","in_trash":false,"is_bookmarked":false,"is_contact_suspended":false,"is_content_confidential":false,"is_content_warning":false,"is_doi_reserved":false,"is_in_pending_publishing":false,"is_in_transfer":false,"is_owner":true,"is_research":true,"is_retracted":false,"is_shared_directly":false,"is_subprotocol":null,"is_unlisted":false,"item_id":891757,"keywords":null,"last_modified":1786390980,"link":"","location":null,"manuscript_citation":"","materials":[],"materials_text":"","mention":null,"mentions":[],"ownership_history":null,"parent_collections":[],"parent_protocols":[],"peer_reviewed":false,"protocol_image_file":{"avg_color":"","created_at":0,"file_name":"avatar.png","guid":"00000000000000000000000000000001","height":400,"mime":"image/png","scan_status":0,"size":0,"url":"https://www.protocols.io/img/default_protocol.png","width":400},"protocol_references":"","public":true,"public_fork_note":"","published_on":1786390980,"references":[],"related_equipments":[],"related_materials":[],"reserved_doi":"","retraction_reason":null,"samples":{},"shared_access_id":106,"should_acknowledge":false,"show_comparison":false,"sign_info":null,"space_access":{"can_preview":false,"can_view":false,"can_edit":false,"can_remove":false,"can_add":false,"can_publish":true,"can_get_doi":true,"can_share":false,"can_share_organization":false,"can_move":false,"can_move_outside":false,"can_transfer":false,"can_download":false,"limited_run":false,"limited_private_links":false,"limited_blind_links":false,"is_locked":false},"space_id":3610,"state_version_id":1050,"stats":{"is_voted":false,"number_of_views":0,"number_of_steps":11,"number_of_bookmarks":0,"number_of_comments":0,"number_of_bookmarked_comments":0,"number_of_steps_comments":0,"number_of_protocol_comments":0,"number_of_exports":1,"number_of_runs":0,"number_of_votes":0,"number_of_reagents":0,"number_of_equipments":0,"number_of_collections":0,"number_of_forks":{"private":0,"public":0},"number_of_accessible_forks":0},"status":{"id":1,"info":"We use this protocol and it's working."},"steps":[{"id":1375003,"guid":"0A3251E0B15111EC86B85F1DE6A2B24F","previous_id":0,"previous_guid":null,"section":"\u003cp\u003eReceiving Samples\u003c/p\u003e","section_color":"#A492FF","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"8ttho\",\"text\":\"When samples (acinar in PBS, islets in trizol, transposed islets for ATAC-Seq, snap-frozen islets) are received, match what is physically sent with sample info list sent by the center and make sure all samples are accounted for. Take note of the condition of the samples. \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}","data":null,"protocol_id":59695,"case_id":0,"critical_ids":"","duration":0,"original_id":0,"number":"1","cases":[],"critical":null},{"id":1375004,"guid":"A170E300B15111EC95728FE37DB67D22","previous_id":1375003,"previous_guid":"0A3251E0B15111EC86B85F1DE6A2B24F","section":"\u003cp\u003eReceiving Samples\u003c/p\u003e","section_color":"#A492FF","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"ekmip\",\"text\":\"Let isolation center i.e. Edmonton know samples were received and in what condition. \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}","data":null,"protocol_id":59695,"case_id":0,"critical_ids":"","duration":0,"original_id":0,"number":"2","cases":[],"critical":null},{"id":1375024,"guid":"B7BCB690B15411EC95728FE37DB67D22","previous_id":1375004,"previous_guid":"A170E300B15111EC95728FE37DB67D22","section":"\u003cp\u003eReceiving Samples\u003c/p\u003e","section_color":"#A492FF","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"dh06h\",\"text\":\"Print QR barcodes for the acinar samples using the IDs for each individual donor in the following format: EDMN#ACIN. Edmonton donor ID are usually in the format 'RXXX', such as 'R405' or 'R364'. So, when naming the acinar tissue samples, replace the 'R' with 'EDMN' and add an 'ACIN' suffix to the end. For instance, the acinar tissue for donor 'R405' has to be barcoded as 'EDMN405ACIN', the acinar tissue for donor 'R364' has to be barcoded as 'EDMN364ACIN'.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}","data":null,"protocol_id":59695,"case_id":0,"critical_ids":"","duration":0,"original_id":0,"number":"3","cases":[],"critical":null},{"id":1375025,"guid":"F196E4D0B15411EC95728FE37DB67D22","previous_id":1375024,"previous_guid":"B7BCB690B15411EC95728FE37DB67D22","section":"\u003cp\u003eReceiving Samples\u003c/p\u003e","section_color":"#A492FF","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"f7bde\",\"text\":\"Store tubes in Yalow -80°C freezer in the same box in which the samples arrived.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}","data":null,"protocol_id":59695,"case_id":0,"critical_ids":"","duration":0,"original_id":0,"number":"4","cases":[],"critical":null},{"id":1375026,"guid":"04A261D0B15511EC95728FE37DB67D22","previous_id":1375025,"previous_guid":"F196E4D0B15411EC95728FE37DB67D22","section":"\u003cp\u003eExtracting DNA and RNA and preparing libraries for ATAC-Seq\u003c/p\u003e","section_color":"#94EBFF","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"cq74\",\"text\":\"Thaw acinar tissue samples, islet samples in trizol, and transposed DNA for ATAC-Seq on ice. \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}","data":null,"protocol_id":59695,"case_id":0,"critical_ids":"","duration":0,"original_id":0,"number":"5","cases":[],"critical":null},{"id":1375027,"guid":"10D84C30B15511EC95728FE37DB67D22","previous_id":1375026,"previous_guid":"04A261D0B15511EC95728FE37DB67D22","section":"\u003cp\u003eExtracting DNA and RNA and preparing libraries for ATAC-Seq\u003c/p\u003e","section_color":"#94EBFF","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"4ua0j\",\"text\":\"Use DNA extraction protocol for DNeasy Blood \\u0026 Tissue Kit (https://protocols.io/view/dna-extraction-qiagen-dneasy-blood-amp-tissue-kit-bjngkmbw) to extract DNA from the acinar samples. Follow this protocol to prepare libraries for ATAC-Seq (https://www.protocols.io/edit/sop55v1-tgd-atac-seq-library-prep-bx38pqrw) from transposed DNA. Follow this protocol to extract RNA from islet samples in trizol (https://www.protocols.io/edit/sop05v1-tgd-rnaextraction-phenol-chloroform-bn6vmhe6).\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"key\":0,\"offset\":59,\"length\":84},{\"key\":1,\"offset\":241,\"length\":72},{\"key\":2,\"offset\":402,\"length\":82}],\"data\":{}}],\"entityMap\":{\"0\":{\"type\":\"link\",\"mutability\":\"\",\"data\":{\"guid\":\"1732ED9BB15511EC9DA90A58A9FEAC02\",\"url\":\"https://protocols.io/view/dna-extraction-qiagen-dneasy-blood-amp-tissue-kit-bjngkmbw\"}},\"1\":{\"type\":\"link\",\"mutability\":\"MUTABLE\",\"data\":{\"guid\":\"88C5480F1CA211ED84CD0A58A9FEAC02\",\"url\":\"https://www.protocols.io/edit/sop55v1-tgd-atac-seq-library-prep-bx38pqrw\"}},\"2\":{\"type\":\"link\",\"mutability\":\"MUTABLE\",\"data\":{\"guid\":\"BD7452061CA211ED84CD0A58A9FEAC02\",\"url\":\"https://www.protocols.io/edit/sop05v1-tgd-rnaextraction-phenol-chloroform-bn6vmhe6\"}}}}","data":null,"protocol_id":59695,"case_id":0,"critical_ids":"","duration":0,"original_id":0,"number":"6","cases":[],"critical":null},{"id":1375028,"guid":"1E50EFC0B15511EC95728FE37DB67D22","previous_id":13225921,"previous_guid":"8386C5F35B66446CAB0858FB5FFA51AF","section":"\u003cp\u003eQC\u003c/p\u003e","section_color":"#84CE84","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"svmk\",\"text\":\"After DNA and RNA extractions, measure concentrations by nanodrop, taking account of 260/280 and 260/230 values as well. 260/280 value should be close to 1.8 for DNA and around 2.0 for DNA and 260/230 should be around 1.8-2.0. \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}","data":null,"protocol_id":59695,"case_id":0,"critical_ids":"","duration":0,"original_id":0,"number":"8","cases":[],"critical":null},{"id":1375029,"guid":"292463F0B15511EC95728FE37DB67D22","previous_id":1375028,"previous_guid":"1E50EFC0B15511EC95728FE37DB67D22","section":"\u003cp\u003eQC\u003c/p\u003e","section_color":"#84CE84","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"3p4ps\",\"text\":\"For DNA samples, take a portion of the sample to measure concentration by Qubit. Protocol can be found here: https://protocols.io/view/qubit-dsdna-assays-bnstmeen. For genotyping, Qubit concentration should be above 50 ng/uL and total DNA should be above 500 ng. For RNA samples, measure the concentration and RNA integrity number (RIN) using the bioanalyzer while following this protocol: https://www.protocols.io/edit/sop08v1-2100agilentbioanalyzerrna6000-bqjqmumw). For ATAC-Seq libraries, determine the concentrations and fragment size distribution using the bioanalyzer following this protocol: https://www.protocols.io/edit/sop17v1-tgd-bioanalyzerdnahs-casisece.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"key\":0,\"offset\":109,\"length\":53},{\"key\":1,\"offset\":390,\"length\":76},{\"key\":2,\"offset\":600,\"length\":67}],\"data\":{}}],\"entityMap\":{\"0\":{\"type\":\"link\",\"mutability\":\"\",\"data\":{\"guid\":\"2EA688B0B15511EC9DA90A58A9FEAC02\",\"url\":\"https://protocols.io/view/qubit-dsdna-assays-bnstmeen\"}},\"1\":{\"type\":\"link\",\"mutability\":\"MUTABLE\",\"data\":{\"guid\":\"656C6C391CA311ED84CD0A58A9FEAC02\",\"url\":\"https://www.protocols.io/edit/sop08v1-2100agilentbioanalyzerrna6000-bqjqmumw\"}},\"2\":{\"type\":\"link\",\"mutability\":\"MUTABLE\",\"data\":{\"guid\":\"A9B80C471CA311ED84CD0A58A9FEAC02\",\"url\":\"https://www.protocols.io/edit/sop17v1-tgd-bioanalyzerdnahs-casisece\"}}}}","data":null,"protocol_id":59695,"case_id":0,"critical_ids":"","duration":0,"original_id":0,"number":"9","cases":[],"critical":null},{"id":1375030,"guid":"2FA08BF0B15511EC95728FE37DB67D22","previous_id":1375029,"previous_guid":"292463F0B15511EC95728FE37DB67D22","section":"\u003cp\u003eQC\u003c/p\u003e","section_color":"#84CE84","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"9ab69\",\"text\":\"Create QR codes that include sample name in this format for the DNA and RNA samples: EDMN#DNA and EDMN#RNA. Label should also include nanodrop concentration and QC info. \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}","data":null,"protocol_id":59695,"case_id":0,"critical_ids":"","duration":0,"original_id":0,"number":"10","cases":[],"critical":null},{"id":1375032,"guid":"85B2D930B15511EC95728FE37DB67D22","previous_id":1375030,"previous_guid":"2FA08BF0B15511EC95728FE37DB67D22","section":"\u003cp\u003eDNA Genotyping, RNA-Seq, and ATAC-Seq\u003c/p\u003e","section_color":"#FFED92","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"d07iv\",\"text\":\"For DNA genotyping, record sample info, nanodrop QC and Qubit information in genotyping QC spreadsheet, which will be sent to the SFGF core whenever the entire batch is ready (follow this protocol: https://www.protocols.io/edit/sop54v1-tgd-genotypingsubmissionforcollaborators-b8jaruie). Submit RNA samples and ATAC-Seq libraries to Novogene for RNA-Seq and ATAC-Seq, respectively, following this protocol (https://www.protocols.io/edit/sop12v1-tgd-novogenesequencingsubmission-cekytcxw). You will have to provide QC information to Novogene prior to submission of samples.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"key\":0,\"offset\":198,\"length\":87},{\"key\":1,\"offset\":407,\"length\":79}],\"data\":{}}],\"entityMap\":{\"0\":{\"type\":\"link\",\"mutability\":\"MUTABLE\",\"data\":{\"guid\":\"4CE3060C1CA611ED84CD0A58A9FEAC02\",\"url\":\"https://www.protocols.io/edit/sop54v1-tgd-genotypingsubmissionforcollaborators-b8jaruie\"}},\"1\":{\"type\":\"link\",\"mutability\":\"MUTABLE\",\"data\":{\"guid\":\"9521C80A1CA511ED84CD0A58A9FEAC02\",\"url\":\"https://www.protocols.io/edit/sop12v1-tgd-novogenesequencingsubmission-cekytcxw\"}}}}","data":null,"protocol_id":59695,"case_id":0,"critical_ids":"","duration":0,"original_id":0,"number":"11","cases":[],"critical":null},{"id":13225921,"guid":"8386C5F35B66446CAB0858FB5FFA51AF","previous_id":1375027,"previous_guid":"10D84C30B15511EC95728FE37DB67D22","section":"\u003cp\u003eExtracting DNA and RNA and preparing libraries for ATAC-Seq\u003c/p\u003e","section_color":"#94EBFF","section_duration":0,"is_substep":false,"step":"{\"blocks\":[{\"key\":\"624il\",\"text\":\"For naming the DNA samples, replace the 'ACIN' suffix at the end of the ID assigned to the acinar tissue with 'DNA'. For instance, the acinar tissue for donor 'R405' will be named 'EDMN405ACIN', so the DNA extracted has to be named 'EDMN405DNA'. For RNA, follow the same instructions, except that you have to use 'RNA' as the suffix instead of 'DNA'.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}","data":null,"protocol_id":59695,"case_id":0,"critical_ids":"","duration":0,"original_id":0,"number":"7","cases":[],"critical":null}],"table_of_contents":[{"title":"\u003cp\u003eReceiving Samples\u003c/p\u003e","color":"#A492FF","first_step_guid":"0A3251E0B15111EC86B85F1DE6A2B24F"},{"title":"\u003cp\u003eExtracting DNA and RNA and preparing libraries for ATAC-Seq\u003c/p\u003e","color":"#94EBFF","first_step_guid":"04A261D0B15511EC95728FE37DB67D22"},{"title":"\u003cp\u003eQC\u003c/p\u003e","color":"#84CE84","first_step_guid":"1E50EFC0B15511EC95728FE37DB67D22"},{"title":"\u003cp\u003eDNA Genotyping, RNA-Seq, and ATAC-Seq\u003c/p\u003e","color":"#FFED92","first_step_guid":"85B2D930B15511EC95728FE37DB67D22"}],"template_id":4,"title":"SOP51v1_TGD_EdmontonSampleProcessing","title_html":"\u003cp\u003eSOP51v1_