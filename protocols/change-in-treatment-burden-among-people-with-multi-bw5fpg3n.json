"affiliation_url":null,"link":null,"is_private_profile":false,"is_verified_user":false,"user_image_file":{"guid":"00000000000000000000000000000001","file_name":"avatar.png","url":"https://www.protocols.io/img/avatars/001.png","mime":"image/png","size":0,"width":100,"height":100,"avg_color":"","scan_status":0,"created_at":0}},{"first_name":"Forbes","last_name":"Watson","affiliation":"University of Southampton","note":"","guid":"","username":"","name":"Forbes Watson","affiliation_url":null,"link":null,"is_private_profile":false,"is_verified_user":false,"user_image_file":{"guid":"00000000000000000000000000000001","file_name":"avatar.png","url":"https://www.protocols.io/img/avatars/001.png","mime":"image/png","size":0,"width":100,"height":100,"avg_color":"","scan_status":0,"created_at":0}},{"first_name":"Hajira","last_name":"Dambha-Miller","affiliation":"University of Southampton","note":"","guid":"","username":"","name":"Hajira Dambha-Miller","affiliation_url":null,"link":null,"is_private_profile":false,"is_verified_user":false,"user_image_file":{"guid":"00000000000000000000000000000001","file_name":"avatar.png","url":"https://www.protocols.io/img/avatars/001.png","mime":"image/png","size":0,"width":100,"height":100,"avg_color":"","scan_status":0,"created_at":0}},{"first_name":"Helen","last_name":"Roberts","affiliation":"University of Southampton","note":"","guid":"","username":"","name":"Helen Roberts","affiliation_url":null,"link":null,"is_private_profile":false,"is_verified_user":false,"user_image_file":{"guid":"00000000000000000000000000000001","file_name":"avatar.png","url":"https://www.protocols.io/img/avatars/001.png","mime":"image/png","size":0,"width":100,"height":100,"avg_color":"","scan_status":0,"created_at":0}}],"before_start":"","book_chapter":null,"can_accept_authorship":false,"can_be_copied":true,"can_claim_authorship":false,"can_manage_keywords":true,"can_remove_fork":false,"can_sign":false,"child_steps":{},"cited_protocols":[],"collection_items":[],"created_on":1628087826,"creator":{"name":"H.O.Hounkpatin","first_name":"","last_name":"","affiliation":"","affiliation_url":null,"username":"m4wle132x115rle1","link":null,"user_image_file":{"guid":"00000000000000000000000000000001","file_name":"avatar.png","url":"https://www.protocols.io/img/avatars/001.png","mime":"image/png","size":0,"width":100,"height":100,"avg_color":"","scan_status":0,"created_at":0},"badges":[{"id":2,"name":"Author","image":{"source":"https://files.protocols.io/webapp/images/q2ckeg/badges/bronze.svg","placeholder":"https://files.protocols.io/webapp/images/q2ckeg/badges/bronze.svg"}}],"affiliations":[]},"cross_cloud_origin":null,"description":"{\"blocks\":[{\"key\":\"efi4g\",\"text\":\"Treatment burden is the effort required of patients to look after their health and the impact this has on their functioning and wellbeing. It is likely treatment burden changes over time as circumstances change for patients and health services. However, there are a lack of population-level studies of treatment burden change and factors associated with this change over time. Furthermore, there are currently no practical screening tools for treatment burden in time-pressured clinical settings or at population level.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"9k9vk\",\"text\":\"\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"em750\",\"text\":\"Methods and analysis\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"style\":\"bold\",\"offset\":0,\"length\":20}],\"entityRanges\":[],\"data\":{}},{\"key\":\"fjltn\",\"text\":\"\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"4ktja\",\"text\":\"This is a three-year follow-up of a cross-sectional survey of 700+ people with multimorbidity (defined as three or more long-term conditions; LTCs) registered at GP practices in in Dorset, England. The survey will repeat collection of information on treatment burden (using the 10-item Multimorbidity Treatment Burden Questionnaire (MTBQ) and a novel single-item screening tool), sociodemographics, medications, LTCs, health literacy and financial resource, as at baseline. Descriptive statistics will be used to compare change in treatment burden since the baseline survey in 2019 and associations of treatment burden change will be assessed using regression methods. Diagnostic test accuracy metrics will be used to evaluate the single-item treatment burden screening tool using the MTBQ as the gold-standard. Routine primary care data (including demographics, medications, LTCs, and healthcare usage data) will be extracted from medical records for consenting participants. A forward-stepwise, likelihood-ratio logistic regression model building approach will be employed in order to assess the utility of routine data metrics in quantifying treatment burden in comparison to self-reported treatment burden using the MTBQ.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"b3tlu\",\"text\":\"\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"91nl6\",\"text\":\"Impact\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"style\":\"bold\",\"offset\":0,\"length\":6}],\"entityRanges\":[],\"data\":{}},{\"key\":\"crp7h\",\"text\":\"\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"acrpp\",\"text\":\"To the authors’ knowledge, this will be the first study investigating longitudinal aspects of treatment burden. Findings will improve understanding of the extent to which treatment burden changes over time for people with multimorbidity and factors contributing to this change, as well as allowing better identification of people at risk of high treatment burden. \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"8je4j\",\"text\":\"\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{}}","disclaimer":"","document":"","documents":null,"doi":"dx.doi.org/10.17504/protocols.io.bw5fpg3n","doi_status":2,"ethics_statement":null,"fork_id":null,"fork_info":null,"fork_info_status":"not_fork","forks":[],"funders":[],"groups":[{"id":30489,"uri":"university-of-southampton3","title":"University of Southampton","is_public":true,"image":{"source":"https://s3.amazonaws.com/protocols-files/files/E60BE85D2A9411EC96350A58A9FEAC02-placeholder.png","placeholder":"https://s3.amazonaws.com/protocols-files/files/E60BE85D2A9411EC96350A58A9FEAC02-placeholder.png"},"tech_support":{"email":null,"phone":null,"use_email":false,"hide_contact":false,"url":null}}],"guid":"634C75D0F53111EBB59045CDE8204559","guidelines":"","has_references":false,"has_step_reagents":false,"has_versions":false,"id":52103,"image":{"placeholder":null,"source":"https://www.protocols.io/img/default_protocol.png","webp_placeholder":null,"webp_source":null},"image_attribution":"","in_trash":false,"is_bookmarked":false,"is_contact_suspended":false,"is_content_confidential":false,"is_content_warning":false,"is_doi_reserved":false,"is_in_pending_publishing":false,"is_in_transfer":false,"is_owner":true,"is_research":false,"is_retracted":false,"is_shared_directly":false,"is_subprotocol":null,"is_unlisted":false,"item_id":817507,"keywords":"item multimorbidity treatment burden questionnaire, associations of treatment burden change, level studies of treatment burden change, treatment burden among people, longitudinal aspects of treatment burden, quantifying treatment burden, treatment burden change, reported treatment burden, change in treatment burden, treatment burden in comparison, people with multimorbidity, likely treatment burden, treatment burden, high treatment burden, practical screening tools for treatment burden, multimorbidity, risk of high treatment burden, routine primary care data, item treatment burden, healthcare usage data, clinical setting, primary care, pressured clinical setting, health literacy, health, wellbeing, health service, patient, questionnaire","last_modified":1779107419,"link":"https://doi.org/10.1371/journal.pone.0260228","location":null,"manuscript_citation":"Hounkpatin HO,  Roderick P,  Morris JE,  Harris S,  Watson F,  Dambha-Miller H,  Roberts H,  Walsh B,  Smith D,  Fraser SDS,   obotAWTBG (2021) Change in treatment burden among people with multimorbidity: Protocol of a follow up survey and development of efficient measurement tools for primary care. PLoS ONE  16(11): e0260228. doi: \u003ca target=\"_blank\" href=\"https://dx.doi.org/10.1371/journal.pone.0260228\"\u003e10.1371/journal.pone.0260228\u003c/a\u003e ","materials":[],"materials_text":"","mention":null,"mentions":[{"guid":"81C0283F383011F0906406A1DC1B6199","content":{"content_type_id":1,"content_id":52103},"journal_id":1,"journal_name":"PLOS One","article_id":"10.1371/journal.pone.0260228","article_url":"https://doi.org/10.1371/journal.pone.0260228","article_citation":"Hounkpatin HO,  Roderick P,  Morris JE,  Harris S,  Watson F,  Dambha-Miller H,  Roberts H,  Walsh B,  Smith D,  Fraser SDS,   obotAWTBG (2021) Change in treatment burden among people with multimorbidity: Protocol of a follow up survey and development of efficient measurement tools for primary care. PLoS ONE  16(11): e0260228. doi: \u003ca target=\"_blank\" href=\"https://dx.doi.org/10.1371/journal.pone.0260228\"\u003e10.1371/journal.pone.0260228\u003c/a\u003e ","created_on":1638288362,"is_main":false}],"ownership_history":null,"parent_collections":[],"parent_protocols":[],"peer_reviewed":false,"protocol_image_file":{"avg_color":"","created_at":0,"file_name":"avatar.png","guid":"00000000000000000000000000000001","height":400,"mime":"image/png","scan_status":0,"size":0,"url":"https://www.protocols.io/img/default_protocol.png","width":4